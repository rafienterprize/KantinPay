# KantinPay Environment Variables Template
DATABASE_URL=""
JWT_SECRET="change_me_to_a_strong_random_secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare Turnstile (Bot & Brute-Force Protection on /login)
# Local testing keys (always pass): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""
TURNSTILE_HOSTNAMES="localhost,127.0.0.1"

# Cloudflare Proxy Origin Lock (set "true" in production behind Cloudflare Orange Cloud)
REQUIRE_CLOUDFLARE_PROXY="false"
